# Cloudflare Tunnel — copy ke .env dan isi token Anda
# Dapatkan di: Cloudflare Zero Trust > Networks > Tunnels > Create Tunnel > Copy Token
TUNNEL_TOKEN=eyJhIjoiXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Opsional: untuk dokumentasi, bukan dipakai compose
TUNNEL_HOSTNAME=buah.example.com
# PORT web (default 5000)
PORT=5000
